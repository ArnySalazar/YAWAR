# Copiar a .env y completar. El archivo .env NUNCA se sube al repositorio.

# 1 = no se llama a WhatsApp; los mensajes se guardan en memoria (para desarrollo y pruebas)
MODO_PRUEBA=1

# Clave para scripts y pruebas que llaman a la API sin navegador (encabezado X-API-Key)
API_CLAVE=

# Acceso al panel con usuario y contraseña. Los usuarios se crean con:
#   python -m scripts.usuarios crear <usuario> "<nombre>"
# 0 deja el panel abierto (solo en desarrollo y solo si API_CLAVE también está vacía)
PANEL_LOGIN=1
SESION_HORAS=12
# 1 = la cookie de sesión solo viaja por HTTPS (localhost también funciona). 0 solo para probar
# desde otro equipo de la red local por http
SESION_COOKIE_SEGURA=1
# 0 = oculta /docs y /openapi.json; recomendado cuando la API está publicada
MOSTRAR_DOCS=1

# Zona horaria para calcular semanas y días sin respuesta
ZONA_HORARIA=America/Lima

# Base de datos (SQLite basta para la demo)
DATABASE_URL=sqlite:///./yawar.db

# WhatsApp Cloud API (modo de pruebas de Meta)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
WA_VERIFY_TOKEN=elige-una-frase-secreta
WA_APP_SECRET=
# Plantilla aprobada para el recordatorio semanal (con 3 botones de respuesta rapida)
WA_PLANTILLA_RECORDATORIO=recordatorio_hierro
WA_PLANTILLA_IDIOMA=es

# Reglas de seguimiento (definir con el asesor de salud)
DIAS_SIN_RESPUESTA=7
UMBRAL_META_ALERTA=0.3
