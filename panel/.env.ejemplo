# Opcional: copiar a panel/.env solo si necesitas cambiar algo. Sin este archivo se usan los valores de aquí.

# A dónde reenvía Vite las llamadas del panel (/api/...) durante el desarrollo
API_DESTINO=http://localhost:8000

# Prefijo con el que el panel llama a la API (déjalo así salvo que la API se sirva en otra URL)
VITE_API_URL=/api

# Establecimientos del selector, separados por coma. La API todavía no tiene una ruta que los liste.
VITE_ESTABLECIMIENTOS=EESS01,EESS02,EESS03
