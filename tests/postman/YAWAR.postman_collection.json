        {
          "name": "Verificar webhook (como Meta)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/webhook?hub.mode=subscribe&hub.verify_token={{wa_verify_token}}&hub.challenge=1234567890",
